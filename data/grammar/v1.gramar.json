{
  "grammar_version": 1,
  "name": "Screenplay Analytical DSL Grammar",
  "delimiters": [" ", "=", ">", "<", ",", "'"],
  "keywords": {
    "commands": {
      "COUNT": "CommandCount",
      "SUM": "CommandSum",
      "GET": "CommandGet"
    },
    "targets": {
      "acts": "TargetActs",
      "blocks": "TargetBlocks",
      "scenes": "TargetScenes",
      "characters": "TargetCharacters"
    },
    "operators": {
      "WHERE": "OpWhere",
      "AND": "OpAnd",
      "OR": "OpOr",
      "NOT": "opNot",
      "=": "OpEq",
      ">": "OpGt",
      "<": "OpLt"
    },
    "fields": {
      "type": "FieldBlockType",
      "words": "FieldWordCount",
      "character": "FieldCharacterName",
      "lines": "FieldLineCount"
    }
  }
}